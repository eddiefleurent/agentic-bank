         "enum": [
          "occupation",
          "declared_monthly_income_cents",
          "expected_monthly_volume_cents",
          "risk_rating",
          "account_open_date",
          "expected_countries",
          "notes",
          "activity_summary",
          "prior_alerts"
         ],
         "type": "string"
        },
        "maxItems": 5,
        "title": "Kyc Fields",
        "type": [
         "array",
         "null"
        ]
       },
       "statement": {
        "maxLength": 600,
        "minLength": 1,
        "title": "Statement",
        "type": "string"
       },
       "txn_ids": {
        "description": "Transaction ids this rests on.",
        "items": {
         "pattern": "^T\\d{6}$",
         "type": "string"
        },
        "maxItems": 12,
        "title": "Txn Ids",
